{
    "labelPlacement": "top_label",
    "descriptionPlacement": "below",
    "cssClass": "kwv-career-form",
    "button": {
        "type": "text",
        "text": "Submit application"
    },
    "title": "KWV Job Application",
    "description": "",
    "fields": [
        {
            "id": 2,
            "type": "text",
            "label": "Name",
            "isRequired": true,
            "autocompleteAttribute": "given-name",
            "enableAutocomplete": true,
            "layoutGridColumnSpan": 6,
            "layoutGroupId": "kwvname"
        },
        {
            "id": 3,
            "type": "text",
            "label": "Surname",
            "isRequired": true,
            "autocompleteAttribute": "family-name",
            "enableAutocomplete": true,
            "layoutGridColumnSpan": 6,
            "layoutGroupId": "kwvname"
        },
        {
            "id": 1,
            "type": "email",
            "label": "Email",
            "isRequired": true,
            "autocompleteAttribute": "email",
            "enableAutocomplete": true,
            "layoutGridColumnSpan": 6,
            "layoutGroupId": "kwvcontact"
        },
        {
            "id": 10,
            "type": "phone",
            "label": "Phone",
            "isRequired": true,
            "phoneFormat": "international",
            "autocompleteAttribute": "tel",
            "enableAutocomplete": true,
            "layoutGridColumnSpan": 6,
            "layoutGroupId": "kwvcontact"
        },
        {
            "id": 11,
            "type": "fileupload",
            "label": "CV",
            "isRequired": true,
            "allowedExtensions": "pdf,doc,docx",
            "maxFileSize": 5,
            "multipleFiles": false
        },
        {
            "id": 17,
            "type": "hidden",
            "label": "Job ID",
            "defaultValue": "{embed_post:ID}",
            "allowsPrepopulate": true,
            "inputName": "job_id"
        },
        {
            "id": 15,
            "type": "hidden",
            "label": "Job Title",
            "defaultValue": "",
            "allowsPrepopulate": true,
            "inputName": "job_title"
        },
        {
            "id": 16,
            "type": "hidden",
            "label": "Job Reference",
            "defaultValue": "",
            "allowsPrepopulate": true,
            "inputName": "job_ref"
        },
        {
            "id": 18,
            "type": "hidden",
            "label": "Job Link",
            "defaultValue": "",
            "allowsPrepopulate": true,
            "inputName": "job_url"
        },
        {
            "id": 19,
            "type": "hidden",
            "label": "Location",
            "defaultValue": "",
            "allowsPrepopulate": true,
            "inputName": "job_location"
        },
        {
            "id": 20,
            "type": "hidden",
            "label": "Department",
            "defaultValue": "",
            "allowsPrepopulate": true,
            "inputName": "job_department"
        },
        {
            "id": 21,
            "type": "hidden",
            "label": "Closing Date",
            "defaultValue": "",
            "allowsPrepopulate": true,
            "inputName": "job_closing"
        }
    ],
    "confirmations": {
        "CONFIRMATION_ID": {
            "id": "CONFIRMATION_ID",
            "name": "Default Confirmation",
            "isDefault": true,
            "type": "message",
            "message": "<div class=\"kwv-career-confirmation\"><p class=\"kwv-career-confirmation__title\">Thank you, {Name:2}.</p><p>Your application[gravityforms action=\"conditional\" merge_tag=\"{Job Title:15}\" condition=\"isnot\" value=\"\"] for <strong>{Job Title:15}</strong>[/gravityforms][gravityforms action=\"conditional\" merge_tag=\"{Job Reference:16}\" condition=\"isnot\" value=\"\"] (Ref {Job Reference:16})[/gravityforms] has been received, and a copy is on its way to {Email:1}.</p><p>Should you not hear from us within one month of the closing date of the advert, kindly regard your application as unsuccessful.</p></div>"
        }
    },
    "notifications": {
